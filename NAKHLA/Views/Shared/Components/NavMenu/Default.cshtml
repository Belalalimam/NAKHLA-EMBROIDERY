@model NavMenuViewModel

<li class="dropdown1">
    <a href="#" class="dropdown1-btn">By Type</a>
    <div class="dropdown1-menu">
        @foreach (var type in Model.FabricTypes)
        {
            <a asp-controller="Home" asp-action="CategorySearch" asp-route-typeId="@type.Id">@type.Name</a>
        }
    </div>
</li>

<li class="dropdown1">
    <a href="#" class="dropdown1-btn">By Project</a>
    <div class="dropdown1-menu">
        @foreach (var project in Model.ProjectCategories)
        {
            <a asp-controller="Home" asp-action="CategorySearch" asp-route-projectId="@project.Id">@project.Name</a>
        }
    </div>
</li>

<li class="dropdown1">
    <a href="#" class="dropdown1-btn">By Color</a>
    <div class="dropdown1-menu">
        @foreach (var color in Model.ProductColors)
        {
            <a asp-controller="Home" asp-action="CategorySearch" asp-route-colorId="@color.Id">@color.Name</a>
        }
    </div>
</li>